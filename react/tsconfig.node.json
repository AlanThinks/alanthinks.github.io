{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@data/*": ["data/*"],
      "@src/*": ["src/*"],
      "@legacy-css/*": ["../css/*"]
    }
  },
  "include": ["vite.config.ts"]
}
